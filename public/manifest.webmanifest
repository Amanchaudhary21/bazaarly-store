{
  "id": "./",
  "name": "ShopNest - Demo Store",
  "short_name": "ShopNest",
  "description": "A practice online store: search, filters, wish list, cart, coupons, checkout and orders. Demo only, no real payments.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "theme_color": "#0B6E74",
  "background_color": "#0B6E74",
  "categories": ["shopping", "education"],
  "icons": [
    { "src": "img/app/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "img/app/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "img/app/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Today's deals", "url": "./#/deals", "icons": [{ "src": "img/app/icon-192.png", "sizes": "192x192" }] },
    { "name": "Cart", "url": "./#/cart", "icons": [{ "src": "img/app/icon-192.png", "sizes": "192x192" }] },
    { "name": "Your orders", "url": "./#/orders", "icons": [{ "src": "img/app/icon-192.png", "sizes": "192x192" }] }
  ]
}
